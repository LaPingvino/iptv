prepare() {
    cd "${srcdir}"
    if [ -d "${startdir}/vendor" ]; then
        cp -r "${startdir}/vendor" "${srcdir}/vendor"
    fi
}

build() {
    cd "${srcdir}"
    export CGO_ENABLED=0
    go build -mod=vendor -ldflags="-s -w" -o iptv-live-bridge .
}

package() {
    install -Dm755 "${srcdir}/iptv-live-bridge" "${pkgdir}/usr/bin/iptv-live-bridge"
    install -Dm644 "${srcdir}/iptv-live-bridge.service" "${pkgdir}/usr/lib/systemd/system/iptv-live-bridge.service"
    install -Dm644 "${srcdir}/iptv-live-bridge.socket" "${pkgdir}/usr/lib/systemd/system/iptv-live-bridge.socket"
    install -Dm644 "${srcdir}/iptv-live-bridge.conf" "${pkgdir}/etc/iptv-live-bridge.conf"
    
    install -d "${pkgdir}/usr/share/iptv-live-bridge/offline"
    if [ -d "${startdir}/offline" ]; then
        cp -r "${startdir}/offline/"* "${pkgdir}/usr/share/iptv-live-bridge/offline/" 2>/dev/null || true
    fi
    
    install -d "${pkgdir}/usr/share/iptv-live-bridge/testcard"
    if [ -d "${startdir}/testcard" ]; then
        cp -r "${startdir}/testcard/"* "${pkgdir}/usr/share/iptv-live-bridge/testcard/" 2>/dev/null || true
    fi
    
    if [ -f "${startdir}/../../data/lapingvino_follows.json" ]; then
        install -d "${pkgdir}/usr/share/iptv-live-bridge/data"
        install -Dm644 "${startdir}/../../data/lapingvino_follows.json" "${pkgdir}/usr/share/iptv-live-bridge/data/lapingvino_follows.json"
        install -d "${pkgdir}/var/lib/iptv-live-bridge/data"
        install -Dm644 "${startdir}/../../data/lapingvino_follows.json" "${pkgdir}/var/lib/iptv-live-bridge/data/lapingvino_follows.json"
    fi

    install -d "${pkgdir}/var/lib/iptv-live-bridge/esperantotv"
    install -d "${pkgdir}/var/lib/iptv-live-bridge/bahaitv"
}
