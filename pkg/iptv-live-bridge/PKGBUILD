pkgname=iptv-live-bridge
pkgver=4.3.0
pkgrel=1
pkgdesc="High-performance Go-native IPTV Live Bridge with streamglink, BVN, EPG & Dist Builder"
arch=('x86_64')
url="https://github.com/LaPingvino/iptv"
license=('MIT')
depends=('ffmpeg')
makedepends=('go')
backup=('etc/iptv-live-bridge.conf')
source=(
    'iptv-live-bridge.service'
    'iptv-live-bridge.socket'
    'iptv-live-bridge.conf'
    'main.go'
    'proxy.go'
    'linear.go'
    'twitch.go'
    'bvn.go'
    'epg.go'
    'builder.go'
    'follows_data.go'
    'go.mod'
    'go.sum'
)
